        "src/weak-items.js",
        "src/web-vitals.js",
        "src/whats-new.js"
      ]
    },
    {
      "layer": "platform",
      "generatedBy": "npm run build:exams-list",
      "note": "exams.json 레지스트리 번들",
      "patterns": [
        "data/exams.js"
      ]
    },
    {
      "layer": "platform",
      "generatedBy": "node tools/build/stamp_release_notes.js",
      "note": "릴리스 노트·버전 배포 산출물",
      "patterns": [
        "data/release-notes.js",
        "data/version.js"
      ]
    },
    {
      "layer": "feature:dictionary",
      "flag": "dictionary",
      "note": "용어/원료 사전 — manifest.knowledge 스키마 구동",
      "patterns": [
        "src/views/dictionary.js",
        "html/views/dictionary.html",
        "tests/dom/dictionary-schema.dom.test.js",
        "tests/dom/study-dictionary.dom.test.js"
      ]
    },
    {
      "layer": "feature:audiobook",
      "flag": "audiobook",
      "note": "이야기형 오디오북 재생",
      "patterns": [
        "src/views/reader-audio.js"
      ]
    },
    {
      "layer": "feature:audiobook",
      "flag": "audiobook",
      "generatedBy": "npm run build:audio-manifest",
      "patterns": [
        "data/audio_manifest.js"
      ]
    },
    {
      "layer": "feature:refDocs",
      "gate": "콘텐츠 게이트 — 참조자료(ref_md·pdf registry·keyword index) 존재 시 발화. 런타임 features.refDocs 플래그는 2026-10 폐기",
      "note": "참조자료 뷰어·레지스트리",
      "patterns": [
        "src/views/reader-ref-links.js"
      ]
    },
    {
      "layer": "feature:refDocs",
      "gate": "콘텐츠 게이트 — 참조자료(ref_md·pdf registry·keyword index) 존재 시 발화. 런타임 features.refDocs 플래그는 2026-10 폐기",
      "generatedBy": "npm run build:pdf-registry",
      "patterns": [
        "src/pdf-registry.js",
        "src/law-links.js"
      ]
    },
    {
      "layer": "feature:refDocs",
      "gate": "콘텐츠 게이트 — 참조자료(ref_md·pdf registry·keyword index) 존재 시 발화. 런타임 features.refDocs 플래그는 2026-10 폐기",
      "generatedBy": "npm run build:keyword-index",
      "patterns": [
        "src/keyword-index.js"
      ]
    },
    {
      "layer": "feature:pomodoro",
      "flag": "pomodoro",
      "patterns": [
        "src/views/pomodoro.js",
        "tests/dom/study-pomodoro.dom.test.js"
      ]
    },
    {
      "layer": "feature:calcPractice",
      "flag": "calcPractice",
      "note": "배합 계산 연습 + 스크래치패드 캔버스",
      "patterns": [
        "src/trainer-calc.js",
        "src/scratchpad.js",
        "src/views/trainer-calc-practice.js",
        "tests/unit/trainer-calc.test.js",
        "tests/dom/common-scratchpad.dom.test.js"
      ]
    },
    {
      "layer": "feature:regulatory",
      "gate": "references.json.referenceLaw 존재 시 발화 (플래그 아닌 콘텐츠 게이트)",
      "note": "규제 고시 감시 — 라벨·문서 목록은 시험별 references.json에서 유도",
      "patterns": [
        "src/notice-check.js",
        "tests/unit/notice-check.test.js"
      ]
    },
    {
      "layer": "feature:refDocs",
      "gate": "콘텐츠 게이트 — 참조자료(ref_md·pdf registry·keyword index) 존재 시 발화. 런타임 features.refDocs 플래그는 2026-10 폐기",
      "note": "참조자료 링크/레지스트리 테스트",
      "patterns": [
        "tests/unit/pdf-registry.test.js",
        "tests/unit/law-links.test.js"
      ]
    },
    {
      "layer": "domain:cosmetic",
      "flag": "formula",
      "note": "cosmetic 도메인 모듈 — Formula OS 스토어·뷰·규정 검증·CSV + 원료 챌린지 (src/exams/cosmetic/)",
      "patterns": [
        "src/exams/cosmetic/*.js",
        "src/exams/cosmetic/views/*.js",
        "css/exams/cosmetic/*.css",
        "html/exams/cosmetic/*.html",
        "tests/dom/exams/cosmetic/*.dom.test.js",
        "tests/unit/exams/cosmetic/*.test.js",
        "tests/e2e/exams/cosmetic/*.spec.js"
      ]
    },
    {
      "layer": "platform",
      "catchAll": true,
      "note": "테스트 기본 계층 — 피처/도메인 테스트는 위 규칙 패턴으로 선분류",
      "patterns": [
        "tests/**"
      ]
    }
  ]
}
