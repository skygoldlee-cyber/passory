        "css/reader-mermaid.css",
        "css/reader.css",
        "css/study-calendar.css",
        "css/study.css",
        "css/trainer.css",
        "css/ui-overlay.css",
        "data/release-notes.json",
        "html/views/analysis.html",
        "html/views/calendar.html",
        "html/views/dashboard.html",
        "html/views/exam-select.html",
        "html/views/exam.html",
        "html/views/flashcard.html",
        "html/views/quiz.html",
        "html/views/review.html",
        "html/views/textbook-reader.html",
        "html/views/textbook.html",
        "html/views/trainer.html",
        "src/analysis-engine.js",
        "src/app-dashboard.js",
        "src/app-fallback.js",
        "src/app-shell.js",
        "src/app-version.js",
        "src/app.js",
        "src/auth-view.js",
        "src/charts.js",
        "src/combo-doc.js",
        "src/command-palette.js",
        "src/config/**",
        "src/csv-utils.js",
        "src/data-loader.js",
        "src/doc-overlay.js",
        "src/error-telemetry.js",
        "src/exam-context.js",
        "src/exam-data-boot.js",
        "src/exam-viewer.js",
        "src/feedback.js",
        "src/globals.d.ts",
        "src/glossary-query.js",
        "src/html-viewer.js",
        "src/image-zoom.js",
        "src/manual-viewer.js",
        "src/markdown-parser.js",
        "src/mermaid-render.js",
        "src/mermaid-utils.js",
        "src/modal-back.js",
        "src/onboarding.js",
        "src/package.json",
        "src/paths.js",
        "src/practice-registry.js",
        "src/pro-upgrade.js",
        "src/pwa-install-capture.js",
        "src/pwa-install.js",
        "src/pwa-manifest.js",
        "src/questions.js",
        "src/reader-format.js",
        "src/reader-toc.js",
        "src/recommendations.js",
        "src/router.js",
        "src/sanitize.js",
        "src/sha256.js",
        "src/spaced-repetition.js",
        "src/state.js",
        "src/statement-tracker.js",
        "src/storage-keys.js",
        "src/storage.js",
        "src/study-aids.js",
        "src/study-tracker.js",
        "src/supabase-client.js",
        "src/supabase-config.js",
        "src/sync.js",
        "src/textbook-parser.js",
        "src/theme-init.js",
        "src/theme-toggle.js",
        "src/types.js",
        "src/ui-mode.js",
        "src/ui-utils.js",
        "src/usage-stats.js",
        "src/utils.js",
        "src/views/backup.js",
        "src/views/daily-challenge.js",
        "src/views/dashboard.js",
        "src/views/event-listeners.js",
        "src/views/exam-select.js",
        "src/views/exam-sim-review.js",
        "src/views/exam-sim-state.js",
        "src/views/exam-sim-weak.js",
        "src/views/exam-simulator.js",
        "src/views/flashcard.js",
        "src/views/glossary-renderer.js",
        "src/views/listeners-app.js",
        "src/views/listeners-delegation.js",
        "src/views/listeners-dictionary.js",
        "src/views/listeners-flashcard.js",
        "src/views/listeners-quiz.js",
        "src/views/listeners-simulator.js",
        "src/views/navigation.js",
        "src/views/offline-detection.js",
        "src/views/quiz-wrong-cause.js",
        "src/views/quiz.js",
        "src/views/reader-toolbar.js",
        "src/views/study-calendar.js",
        "src/views/textbook-reader.js",
        "src/views/textbook-search.js",
        "src/views/trainer-drill-combo.js",
