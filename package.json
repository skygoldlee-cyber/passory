{
  "name": "passory",
  "version": "2026.10.14",
  "description": "Passory — 멀티시험 자격시험 스마트 학습 플랫폼",
  "engines": {
    "node": ">=24"
  },
  "main": "serve.js",
  "scripts": {
    "build:data": "npm run sync:citations && npm run build:exams-list && npm run build:pdf-registry && npm run build:keyword-index && node tools/build/build_all_data.js && npm run build:story && npm run build:study-md && npm run build:exam-bundles && npm run build:audio-manifest && npm run build:question-chapters && npm run build:id-migration && npm run build:noticediff",
    "build:noticediff": "node tools/build/build_notice_diff.js",
    "build:question-chapters": "node tools/build/build_question_chapters.js",
    "build:id-migration": "node tools/build/build_id_migration.js",
    "build:exams-list": "node tools/build/build_exams_list.js",
    "build:data:law": "node tools/build/index.js --only law",
    "build:data:manufacturing": "node tools/build/index.js --only manufacturing",
    "build:data:safety": "node tools/build/index.js --only safety",
    "build:data:understanding": "node tools/build/index.js --only understanding",
    "build:pdf-registry": "node tools/build/build_pdf_registry.js",
    "build:keyword-index": "node tools/build/build_keyword_index.js",
    "build:exam-bundles": "node tools/build/build_exam_bundles.js",
    "build:audio-manifest": "node tools/build/build_audio_manifest.js",
    "sync:citations": "node tools/sync/sync_citation_lines.js",
    "postbuild:data": "npm run check:parser",
    "check:parser": "node tools/check/check_parser_parity.js",
    "check:imports": "node tools/check/check_imports.js",
    "check:posind": "node tools/check/check_position_independence.js",
    "check:combo": "node tools/check/check_combo_pilot.js",
    "check:refsubjects": "node tools/check/check_ref_subjects.js",
    "check:refmerge": "node tools/check/check_refmerge.js",
    "check:refs": "node tools/check/run.js --preset refs",
    "check:fresh": "node tools/check/run.js --preset freshness",
    "check:reflayout": "node tools/check/check_reflayout.js",
    "check:reffresh": "node tools/check/check_ref_freshness.js",
    "check:reflines": "node tools/check/check_ref_lines.js",
    "check:numbering": "node tools/check/check_numbering.js",
    "check:drillfresh": "node tools/check/check_drill_freshness.js",
    "check:embfresh": "node tools/check/check_emb_freshness.js",
    "check:vendor": "node tools/check/check_vendor.js",
    "sync:vendor": "node tools/sync/sync_vendor.js",
    "build:embeddings": "python ref-pipeline/embeddings/build_embeddings.py",
    "check:answers": "node tools/check/check_answer_overlap.js",
    "fix:quotes": "node tools/sync/fix_answer_quotes.js",
    "fix:citations": "node tools/sync/fix_citation_targets.js",
    "check:docbundles": "node tools/build/build_doc_bundles.js --check",
    "check:datafresh": "node tools/check/check_data_freshness.js",
    "check:hooks": "node tools/check/check_hooks.js",
    "check:lawurls": "node tools/check/check_law_urls.js",
    "check:linklint": "node tools/check/check_link_lint.js",
    "check": "node tools/check/run.js",
    "check:docs": "node tools/check/run.js --preset docs",
    "check:textbookdocs": "node tools/check/check_textbook_docs.js",
    "check:domainmap": "node tools/check/check_domain_map.js",
    "build:html": "node tools/build/build_html.js",
    "check:html": "node tools/build/build_html.js --check",
    "check:docsync": "node tools/check/check_doc_sync.js",
    "check:testfirst": "node tools/check/check_test_first.js",
    "check:inventory": "node tools/check/check_inventory.js",
    "check:commands": "node tools/check/check_npm_commands.js",
    "check:plan": "node tools/check/check_plan_features.js",
    "check:featflags": "node tools/check/check_feature_flags.js",
    "check:storage": "node tools/check/check_storage_access.js",
    "check:ciparity": "node tools/check/check_ci_parity.js",
    "check:secrets": "node tools/check/check_secrets.js",
    "check:enc": "node tools/check/check_replacement_char.js",
    "check:orphans": "node tools/check/check_orphan_assets.js",
    "check:notes": "node tools/check/check_release_notes.js",
    "check:specrefs": "node tools/check/check_spec_refs.js",
    "check:perf": "node tools/check/check_perf_budget.js",
    "build:trace": "node tools/build/build_trace_matrix.js",
    "check:trace": "node tools/build/build_trace_matrix.js --check",
    "lint": "eslint src/ tools/ tests/ sw.js serve.js --max-warnings 0 --cache --cache-location node_modules/.cache/eslint",
    "check:types": "tsc -p jsconfig.json --noEmit",
    "hooks:install": "git config core.hooksPath .githooks && echo 'pre-commit/pre-push 훅 활성화됨 (.githooks)'",
    "convert:refs": "python ref-pipeline/convert.py",
    "verify:refs": "python ref-pipeline/convert.py --verify",
    "build:drills": "node tools/build/build_ox_drills.js && node tools/build/build_combo_drills.js",
    "stamp:sw": "node tools/build/stamp_sw_version.js",
    "notes:draft": "node tools/build/stamp_release_notes.js --draft",
    "verify:assets": "node tools/check/verify_shell_assets.js",
    "sbom": "npm sbom --sbom-format spdx > sbom.spdx.json",
    "build:study-md": "node tools/build/build_study_md_bundle.js",
    "build:story": "node tools/build/build_story_textbooks.js",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:dom": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:unit": "c8 --reporter=json --report-dir=coverage-unit --include \"src/**/*.js\" node --test \"tests/unit/**/*.test.js\"",
    "coverage:all": "npm run coverage && npm run coverage:unit && node tools/check/coverage_merge.js --check",
    "ratchet:coverage": "node tools/check/coverage_merge.js --ratchet",
    "test:all": "node --test \"tests/unit/**/*.test.js\" && node tools/check/check_parser_parity.js && node tools/check/check_imports.js && vitest run",
    "test:e2e": "playwright test",
    "test:watch": "node --test --watch \"tests/unit/**/*.test.js\"",
    "serve": "node serve.js",
    "audit:cards": "node tools/check/audit_card_quality.js",
    "check:adlint": "node tools/check/check_adlint_coverage.js",
    "check:manifest": "node tools/check/check_manifest.js",
    "check:content": "node tools/check/run.js --preset content",
    "check:all": "node tools/check/run.js --preset all",
    "check:all:quick": "node tools/check/run.js --preset all --quick",
    "check:all:e2e": "node tools/check/run.js --preset all && npm run test:e2e",
    "check:ci": "node tools/check/run.js --preset ci",
    "deploy": "node tools/deploy/deploy.js",
    "audit:combo": "node tools/check/audit_combo.js",
    "audit:study": "node tools/check/audit_study_quality.js",
    "check:uitext": "node tools/check/check_uitext.js",
    "check:teststats": "node tools/check/check_test_stats.js",
    "stats:stamp": "node tools/check/check_test_stats.js --stamp",
    "check:mobilesafe": "node tools/check/check_mobile_safe.js",
    "check:escape": "node tools/check/check_html_escape.js",
    "check:uistyle": "node tools/check/check_ui_style.js",
    "check:seedkeys": "node tools/check/check_seed_keys.js",
    "scaffold:exam": "node tools/build/scaffold_exam.js",
    "check:runbooks": "node tools/check/check_runbook_links.js",
    "report:errors": "node tools/check/error_report.js",
    "report:funnel": "node tools/check/funnel_report.js",
    "report:feedback": "node tools/check/feedback_report.js",
    "report:dashboard": "node tools/check/dashboard_report.js",
    "report:user": "node tools/check/user_report.js",
    "report:glossary": "node tools/build/extract_glossary_candidates.js",
    "admin:grant-pro": "node tools/check/grant_pro.js",
    "mutate": "stryker run"
  },
  "keywords": [
    "cosmetics",
    "education",
    "pwa",
    "vanilla-js"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "c8": "^12.0.0",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
